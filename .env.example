# Hosted mode only. Put real values in your hosting provider's secret settings.
# This file is documentation; cloud.py reads environment variables, not dotenv files.
WORKDESK_PUBLIC_URL=https://your-workdesk.onrender.com
WORKDESK_DATA_DIR=/var/lib/workdesk
WORKDESK_OWNER_ID=your-numeric-github-user-id
GITHUB_CLIENT_ID=your-oauth-client-id
GITHUB_CLIENT_SECRET=your-oauth-client-secret
WORKDESK_SECRET_KEY=generate-a-random-secret-of-at-least-32-characters
WORKDESK_SYNC_INTERVAL=1800
PORT=10000
